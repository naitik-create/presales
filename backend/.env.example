# Copy to backend/.env and fill in. Never commit the real .env.
# Profiles: APP_ENV=development (laptop), test (laptop), production (Windows server)
APP_ENV=development
APP_NAME=Motadata Presales Intelligence Platform
APP_SECRET_KEY=                      # long random string
DATABASE_URL=postgresql+psycopg://presales_app:<password>@localhost:5432/presales
TEST_DATABASE_URL=postgresql+psycopg://presales_app:<password>@localhost:5432/presales_test
# Fernet key that encrypts API keys saved in Administration > API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up with the database; without it the stored keys cannot be decrypted.
SECRETS_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=                   # optional fallback; a key saved in Administration takes precedence

# Agent models, embedding option, prices and budget are
# maintained in the application's administration screens.

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

EMBEDDING_PROVIDER=local             # initial choice only: local | external
EXTERNAL_EMBEDDING_API_KEY=          # Voyage AI key, only if the external option is used
MODEL_CACHE_PATH=./.model_cache      # local embedding model files

LIBREOFFICE_PATH=                    # e.g. C:\Program Files\LibreOffice\program\soffice.exe
OCR_ENGINE_PATH=                     # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_CONCURRENT_RFP_JOBS=2            # defaults; editable later in Administration > Settings
MAX_QUEUED_RFP_JOBS=20
WORKER_COUNT=2

AUTH_PROVIDER=local
URL_FETCH_ALLOWED_DOMAINS=motadata.com,docs.motadata.com
